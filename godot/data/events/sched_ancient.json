ики Фабия"},"effects":[{"op":"nation.stability","target":"self","delta":4},{"op":"nation.gold","target":"self","delta":20}]}]},{"id":"h_anc_modu","icon":"globe","scope":"country","trigger":{"year":-209,"monthIdx":0,"nation":"xiongnu"},"title":{"en":"Modu Seizes the Tents","ru":"Модэ берёт власть"},"flavor":{"en":"Modu has the chanyu shot with a whistling arrow and takes the leadership of the horse peoples.","ru":"Модэ убивает шаньюя стрелой-свистулькой и становится вождём конных народов."},"autoEffects":[],"choices":[{"label":{"en":"Unite the tribes","ru":"Объединить племена"},"effects":[{"op":"nation.manpower","target":"self","delta":50},{"op":"nation.stability","target":"self","delta":-5}]},{"label":{"en":"Raid the Han frontier","ru":"Грабить границу Хань"},"effects":[{"op":"nation.gold","target":"self","delta":80},{"op":"nation.infamy","target":"self","delta":4}]}]},{"id":"h_anc_antiochus_east","icon":"swords","scope":"country","trigger":{"year":-209,"monthIdx":6,"nation":"seleucid_kingdom"},"title":{"en":"The Eastern Campaign","ru":"Восточный поход"},"flavor":{"en":"Antiochus can march to Bactria and India to win back the lost satrapies, or keep his strength in the west.","ru":"Антиох может двинуться в Бактрию и Индию, чтобы вернуть утраченные сатрапии, или беречь силы на западе."},"autoEffects":[],"choices":[{"label":{"en":"March east","ru":"Идти на восток"},"effects":[{"op":"nation.manpower","target":"self","delta":-40},{"op":"nation.gold","target":"self","delta":-40},{"op":"nation.infamy","target":"self","delta":2},{"op":"nation.research","target":"self","delta":20}]},{"label":{"en":"Stay in the west","ru":"Остаться на западе"},"effects":[{"op":"nation.gold","target":"self","delta":30}]}]},{"id":"h_anc_hasdrubal","icon":"globe","scope":"country","trigger":{"year":-207,"monthIdx":0,"nation":"carthage"},"title":{"en":"Hasdrubal Marches","ru":"Походы Гасдрубала"},"flavor":{"en":"Hannibal's brother crosses the Alps with a second army. If the armies join, Rome may