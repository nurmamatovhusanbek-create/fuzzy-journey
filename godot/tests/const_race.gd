extends SceneTree
## Several threads read every engine table (static var Array / Dictionary; a const one corrupts) at the same time, the way the turn thread and the screen do;
## nothing may change or break. Usage: -s tests/const_race.gd -- [rounds]   (generated list: tools/gen_const_race.py)
var stop := false
func _touch(v: Variant) -> int:
	var n := 0
	if v is Array:
		for e in v:
			var x = e
			n += 1 + _touch(x)
	elif v is Dictionary:
		for k in v:
			var x = v[k]
			n += 1 + _touch(x)
	return n
