func _worker() -> void:
	while not stop: _one()
func _init() -> void:
	var rounds := 300
	var a := OS.get_cmdline_user_args()
	if a.size() > 0: rounds = int(a[0])
	if a.size() > 1: only = int(a[1])
	var before := _snap()
	var ths: Array = []
	for i in 3:
		var t := Thread.new(); t.start(_worker); ths.append(t)
	for r in rounds:
		_one()
		await process_frame
	stop = true
	for t in ths: t.wait_to_finish()
	var after := _snap()
	var changed := 0
	for i in before.size():
		if before[i] != after[i]: changed += 1; print("CHANGED table #", i)
	print("tables: ", before.size())
	print("CONST_RACE OK" if changed == 0 else "CONST_RACE FAIL %d" % changed)
	quit(changed)
